{
  "builds": [
    { "src": "api/*.js", "use": "@vercel/node" },
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "404.html", "use": "@vercel/static" },
    { "src": "upload.html", "use": "@vercel/static" },
    { "src": "robots.txt", "use": "@vercel/static" },
    { "src": "sitemap.xml", "use": "@vercel/static" },
    { "src": "hero.jpg", "use": "@vercel/static" },
    { "src": "hero_1.png", "use": "@vercel/static" },
    { "src": "logo.png", "use": "@vercel/static" },
    { "src": "vid.mp4", "use": "@vercel/static" },
    { "src": "public/**/*", "use": "@vercel/static" }
  ],
  "routes": [
    { 
      "src": "/api/products", 
      "dest": "/api/products.js",
      "headers": {
        "Cache-Control": "no-store, no-cache, must-revalidate, proxy-revalidate",
        "Pragma": "no-cache",
        "Expires": "0"
      }
    },
    { 
      "src": "/api/upload", 
      "dest": "/api/upload.js",
      "headers": {
        "Cache-Control": "no-store, no-cache, must-revalidate, proxy-revalidate",
        "Pragma": "no-cache",
        "Expires": "0"
      }
    },
    { "src": "/api/orders", "dest": "/api/orders.js" },
    { "src": "/api/customers", "dest": "/api/customers.js" },
    { "src": "/api/promocodes", "dest": "/api/promocodes.js" },
    { 
      "src": "/api/settings", 
      "dest": "/api/settings.js",
      "headers": {
        "Cache-Control": "no-store, no-cache, must-revalidate, proxy-revalidate",
        "Pragma": "no-cache",
        "Expires": "0"
      }
    },
    { "src": "/api/auth", "dest": "/api/auth.js" },
    { "src": "/robots.txt", "dest": "/robots.txt" },
    { "src": "/sitemap.xml", "dest": "/sitemap.xml" },
    { "src": "/upload.html", "dest": "/upload.html" },
    { "src": "/404.html", "dest": "/404.html" },
    { "src": "/hero.jpg", "dest": "/hero.jpg" },
    { "src": "/hero_1.png", "dest": "/hero_1.png" },
    { "src": "/logo.png", "dest": "/logo.png" },
    { "src": "/vid.mp4", "dest": "/vid.mp4" },
    { "src": "/public/(.*)", "dest": "/public/$1" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}